# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# CORS - comma separated list of allowed origins (your Next.js frontend URL(s))
CORS_ORIGINS=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lifedrop

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Eligibility engine
# Minimum days required between whole-blood donations.
# NOTE: the current frontend (lib/utils.ts) uses 90 days for its own client-side hint text.
# This backend defaults to 120 days (the previously agreed rule). Align one side with the other.
MIN_DONATION_GAP_DAYS=120
MIN_WEIGHT_KG=45
MIN_HEMOGLOBIN_MALE=13
MIN_HEMOGLOBIN_FEMALE=12
MIN_DONOR_AGE=18
MAX_DONOR_AGE=65

# Seed script (creates the first SUPER_ADMIN)
SEED_SUPER_ADMIN_NAME=System Admin
SEED_SUPER_ADMIN_IDENTIFIER=admin@lifedrop.app
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
